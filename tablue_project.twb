      <aliases enabled='yes' />
      <column caption='max date Recived' datatype='date' name='[Calculation_0262011903819776]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([Date received])}' />
      </column>
      <column caption='Rolling date recived ' datatype='boolean' name='[Calculation_0262011909349379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;month&apos;,&#13;&#10;    DATETRUNC(&apos;month&apos;, [Date received]),&#13;&#10;    DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0262011904401409])&#13;&#10;)&lt;12' />
      </column>
      <column caption='rooling 12 months complaints ' datatype='integer' name='[Calculation_0262011910983684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0262011909349379]=TRUE THEN &#13;&#10;[Number of Records] END)' />
      </column>
      <column caption='Timely Responce' datatype='integer' name='[Calculation_0262011915640837]' role='measure' type='quantitative'>
